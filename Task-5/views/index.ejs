<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Task 5 - API CRUD</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ================================
         NAVBAR
    ================================= -->

    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                Cognifyz Task 5
            </a>

            <span class="text-light">
                REST API + CRUD
            </span>
        </div>
    </nav>


    <!-- ================================
         MAIN
    ================================= -->

    <main class="container py-5">

        <div class="text-center mb-5">
            <h1 class="fw-bold">
                User Management
            </h1>

            <p class="text-muted">
                RESTful API Integration and Front-End Interaction
            </p>
        </div>


        <!-- ================================
             ADD / UPDATE USER FORM
        ================================= -->

        <div class="card shadow-sm mb-5">

            <div class="card-body p-4">

                <h3 class="mb-4">
                    Add User
                </h3>

                <form id="userForm">

                    <input
                        type="hidden"
                        id="userId"
                    >

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label
                                for="name"
                                class="form-label"
                            >
                                Name
                            </label>

                            <input
                                type="text"
                                id="name"
                                class="form-control"
                                placeholder="Enter name"
                                required
                            >

                        </div>


                        <div class="col-md-4">

                            <label
                                for="email"
                                class="form-label"
                            >
                                Email
                            </label>

                            <input
                                type="email"
                                id="email"
                                class="form-control"
                                placeholder="Enter email"
                                required
                            >

                        </div>


                        <div class="col-md-4">

                            <label
                                for="city"
                                class="form-label"
                            >
                                City
                            </label>

                            <input
                                type="text"
                                id="city"
                                class="form-control"
                                placeholder="Enter city"
                                required
                            >

                        </div>

                    </div>


                    <div class="mt-4">

                        <button
                            type="submit"
                            class="btn btn-primary"
                            id="submitBtn"
                        >
                            Add User
                        </button>

                        <button
                            type="button"
                            class="btn btn-secondary d-none"
                            id="cancelBtn"
                        >
                            Cancel
                        </button>

                    </div>

                </form>

            </div>

        </div>


        <!-- ================================
             MESSAGE
        ================================= -->

        <div
            id="message"
            class="alert d-none"
            role="alert"
        ></div>


        <!-- ================================
             USERS
        ================================= -->

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h3 class="mb-0">
                        Users
                    </h3>

                    <button
                        class="btn btn-outline-primary"
                        id="refreshBtn"
                    >
                        Refresh
                    </button>

                </div>


                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">

                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>City</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody id="userTableBody">

                            <tr>
                                <td
                                    colspan="5"
                                    class="text-center text-muted"
                                >
                                    Loading users...
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </main>


    <!-- ================================
         JAVASCRIPT
    ================================= -->

    <script src="/js/script.js"></script>

</body>
</html>