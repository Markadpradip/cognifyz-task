<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container">

        <h1>Registration Successful</h1>

        <div class="profile-card">

            <h2>User Profile</h2>

            <p>
                <strong>Name:</strong>
                <%= user.name %>
            </p>

            <p>
                <strong>Email:</strong>
                <%= user.email %>
            </p>

            <p>
                <strong>Age:</strong>
                <%= user.age %>
            </p>

            <p>
                <strong>City:</strong>
                <%= user.city %>
            </p>

        </div>

        <a href="/">Register Another User</a>

    </div>

</body>
</html>